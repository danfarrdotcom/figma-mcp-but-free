{
	"name": "figma-mcp-but-free",
	"version": "0.4.1",
	"description": "Figma MCP server — free, no rate limits, full read/write via plugin bridge",
	"packageManager": "bun@1.2.10",
	"author": {
		"name": "dan farr",
		"email": "hello@danfarr.com",
		"url": "https://danfarr.com"
	},
	"type": "module",
	"bin": {
		"figma-mcp-but-free": "./dist/index.js"
	},
	"scripts": {
		"build": "tsc",
		"test": "vitest run",
		"dev": "tsx src/index.ts",
		"start": "node dist/index.js",
		"lint": "biome lint ./src",
		"format": "biome format --write ./src",
		"check": "biome check ./src"
	},
	"keywords": [
		"figma",
		"mcp",
		"ai",
		"design",
		"plugin"
	],
	"license": "MIT",
	"dependencies": {
		"@modelcontextprotocol/sdk": "1.12.1",
		"ws": "8.18.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.13",
		"@types/node": "22.15.3",
		"@types/ws": "8.18.1",
		"tsx": "4.19.4",
		"typescript": "5.8.3",
		"vitest": "^3.1.3"
	}
}
